# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL (used for SEO metadata, sitemap, OG tags)
# Local: http://localhost:3000
# Production: https://kekayaan.id (or your Vercel URL)
NEXT_PUBLIC_APP_URL=https://kekayaan.id

# Groq AI API Key (server-only, untuk AI category suggestion pada fitur Ekstraksi Mutasi)
# Daftar gratis di: https://console.groq.com
# PENTING: Jangan prefix dengan NEXT_PUBLIC_ — ini hanya boleh ada di server!
GROQ_API_KEY=
